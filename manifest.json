{
  "manifest_version": 3,
  "name": "TikTok Live Clicker",
  "version": "1.0",
  "description": "Auto-click heart button on TikTok Live streams",
  "permissions": ["activeTab", "scripting", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/@*/live*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
